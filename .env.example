# Vercel injects this automatically when you attach a Blob store
# (Storage -> Create Database -> Blob -> Connect). You do NOT need to set it by
# hand in production — only for local `vercel dev` if you want real persistence.

BLOB_READ_WRITE_TOKEN=

# Access code required to open the app and use the API.
# Defaults to 200467 if unset. IMPORTANT: if this repo is public, set a value
# here in Vercel (Project -> Settings -> Environment Variables) so the real code
# is not the one visible in the committed source.
APP_PIN=
